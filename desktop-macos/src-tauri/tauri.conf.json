{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EditHub",
  "version": "2.3.11",
  "identifier": "com.kpax.edithub",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Projects",
        "width": 1380,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 720,
        "backgroundColor": "#08080a",
        "theme": "Light"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": [
      "icons/icon.icns"
    ],
    "resources": ["resources/resolve_project_bridge.py"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA0RUU2QTcyRjExM0I5RkUKUldUK3VSUHhjbXJ1Qk9qWTVvd0lnRGp4T3JENTV2dlRlZ0VDOGEzdnRmV0NZeTVwOXlCajVxeWcK",
      "endpoints": [
        "https://github.com/darkkpax/EditHub/releases/latest/download/latest.json"
      ]
    }
  }
}
